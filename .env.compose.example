POSTGRES_DB=chat_app_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chat_app_demo

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BOT_WEBHOOK_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
WEBHOOK_SECRET=replace-with-an-incoming-webhook-secret-of-at-least-32-characters

CORS_ORIGIN=http://localhost:5173
FRONTEND_API_URL=/api
FRONTEND_SOCKET_URL=/chat
FRONTEND_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"ello","credential":"change-me"}]
SWAGGER_ENABLED=true
