{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:validate": "node scripts/prisma-validate.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "jest --config jest.config.cjs --runInBand",
        "test:e2e": "jest --config test/jest-e2e.json --runInBand",
        "test:smoke": "node scripts/smoke-test.js",
        "test:load": "node scripts/load-test.js",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.28",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.28",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/platform-socket.io": "^11.1.28",
        "@nestjs/swagger": "^11.4.5",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.28",
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "helmet": "^8.3.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.28",
        "@types/bcrypt": "^6.0.0",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "dotenv": "^17.4.2",
        "eslint": "^10.7.0",
        "jest": "^30.4.2",
        "prettier": "^3.9.5",
        "prisma": "^6.19.3",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    }
}