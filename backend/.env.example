NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true
BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
SOCKET_RATE_LIMIT_TTL_MS=10000
SOCKET_RATE_LIMIT_MAX=60
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_app_demo
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=1d
BOT_WEBHOOK_SECRET=change-me-for-bot-webhooks
DEV_RESET_SECRET=change-me-for-dev-reset
