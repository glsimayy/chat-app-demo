generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum ConversationType {
  direct
  group
  management
}

enum ParticipantRole {
  owner
  manager
  member
}

enum ConversationStatus {
  active
  closed
  archived
}

enum MessageType {
  user
  system
}

enum ContactInvitationStatus {
  pending
  accepted
  declined
}

enum CallStatus {
  ringing
  active
  completed
  missed
  declined
  failed
}

enum SupportTicketPriority {
  low
  medium
  high
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum SupportTicketActivityAction {
  created
  assigned
  unassigned
  transferred
  status_changed
  priority_changed
  note_updated
}

enum AdminMessageAccessReason {
  support_request
  abuse_investigation
  security_incident
  system_test
  other
}

enum MessageReportReason {
  harassment
  sexual_content
  violence_or_threat
  spam
  impersonation
  other
}

enum MessageReportStatus {
  pending
  resolved
  dismissed
}

enum ModerationResolutionAction {
  dismiss
  delete_message
  warn_user
  suspend_user
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  automationId               Int?                      @unique
  email                      String                    @unique
  username                   String                    @unique
  passwordHash               String
  role                       UserRole                  @default(user)
  about                      String?
  location                   String?
  profileImage               String?                   @db.Text
  moderationWarningCount     Int                       @default(0)
  suspendedUntil             DateTime?
  suspensionReason           String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  conversationsCreated       Conversation[]            @relation("ConversationCreator")
  messages                   Message[]
  participants               ConversationParticipant[]
  supportTicketsRequested    SupportTicket[]           @relation("SupportTicketRequester")
  supportTicketsAssigned     SupportTicket[]           @relation("SupportTicketAssignee")
  supportTicketActivities    SupportTicketActivity[]   @relation("SupportTicketActivityActor")
  sentContactInvitations     ContactInvitation[]       @relation("ContactInvitationSender")
  receivedContactInvitations ContactInvitation[]       @relation("ContactInvitationRecipient")
  messageBookmarks           MessageBookmark[]
  conversationPreferences    ConversationPreference[]
  callsPlaced                CallRecord[]              @relation("CallCaller")
  callsReceived              CallRecord[]              @relation("CallRecipient")
  callsEnded                 CallRecord[]              @relation("CallEndedBy")
  adminMessageAccessAudits   AdminMessageAccessAudit[] @relation("AdminMessageAccessActor")
  messageReportsSubmitted    MessageReport[]           @relation("MessageReportReporter")
  messageReportsReviewed     MessageReport[]           @relation("MessageReportReviewer")

  @@index([role])
  @@map("users")
}

model ContactInvitation {
  id          String                  @id @default(uuid()) @db.Uuid
  senderId    String                  @db.Uuid
  recipientId String                  @db.Uuid
  message     String?
  status      ContactInvitationStatus @default(pending)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  respondedAt DateTime?
  sender      User                    @relation("ContactInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User                    @relation("ContactInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@map("contact_invitations")
}

model SupportTicket {
  id              String                  @id @default(uuid()) @db.Uuid
  requesterId     String                  @db.Uuid
  assignedAdminId String?                 @db.Uuid
  subject         String
  message         String                  @db.Text
  priority        SupportTicketPriority   @default(medium)
  status          SupportTicketStatus     @default(open)
  adminNote       String?                 @db.Text
  version         Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  resolvedAt      DateTime?
  requester       User                    @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedAdmin   User?                   @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  activities      SupportTicketActivity[]

  @@index([requesterId, createdAt])
  @@index([assignedAdminId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportTicketActivity {
  id        String                      @id @default(uuid()) @db.Uuid
  ticketId  String                      @db.Uuid
  actorId   String?                     @db.Uuid
  action    SupportTicketActivityAction
  fromValue String?
  toValue   String?
  createdAt DateTime                    @default(now())
  ticket    SupportTicket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?                       @relation("SupportTicketActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorId])
  @@map("support_ticket_activities")
}

model Conversation {
  id                     String                    @id @default(uuid()) @db.Uuid
  type                   ConversationType
  name                   String?
  description            String?
  createdBy              String                    @db.Uuid
  externalRef            String?                   @unique
  isBotManaged           Boolean                   @default(false)
  sourceName             String?
  memberCanSendMessages  Boolean                   @default(false)
  membersCanLeave        Boolean                   @default(true)
  status                 ConversationStatus        @default(active)
  parentConversationId   String?                   @unique @db.Uuid
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  creator                User                      @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  parentConversation     Conversation?             @relation("ManagementConversation", fields: [parentConversationId], references: [id], onDelete: Cascade)
  managementConversation Conversation?             @relation("ManagementConversation")
  messages               Message[]
  participants           ConversationParticipant[]
  preferences            ConversationPreference[]
  calls                  CallRecord[]

  @@index([type])
  @@index([createdBy])
  @@index([status])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String          @db.Uuid
  userId         String          @db.Uuid
  role           ParticipantRole @default(member)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  leftAt         DateTime?
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([role])
  @@index([leftAt])
  @@map("conversation_participants")
}

model Message {
  id                String                    @id @default(uuid()) @db.Uuid
  clientMessageId   String?                   @db.Uuid
  conversationId    String                    @db.Uuid
  senderId          String?                   @db.Uuid
  replyToMessageId  String?                   @db.Uuid
  content           String
  messageType       MessageType               @default(user)
  isForwarded       Boolean                   @default(false)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime?
  deletedAt         DateTime?
  conversation      Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User?                     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo           Message?                  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           Message[]                 @relation("MessageReplies")
  attachments       MessageAttachment[]
  bookmarks         MessageBookmark[]
  adminAccessAudits AdminMessageAccessAudit[]
  reports           MessageReport[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToMessageId])
  @@index([messageType])
  @@index([deletedAt])
  @@map("messages")
}

model AdminMessageAccessAudit {
  id            String                   @id @default(uuid()) @db.Uuid
  adminId       String                   @db.Uuid
  messageId     String                   @db.Uuid
  reason        AdminMessageAccessReason
  justification String                   @db.Text
  createdAt     DateTime                 @default(now())
  admin         User                     @relation("AdminMessageAccessActor", fields: [adminId], references: [id], onDelete: Restrict)
  message       Message                  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([messageId, createdAt])
  @@index([reason])
  @@map("admin_message_access_audits")
}

model MessageReport {
  id                String                      @id @default(uuid()) @db.Uuid
  messageId         String                      @db.Uuid
  reporterId        String                      @db.Uuid
  reason            MessageReportReason
  details           String?                     @db.Text
  status            MessageReportStatus         @default(pending)
  resolutionAction  ModerationResolutionAction?
  resolutionNote    String?                     @db.Text
  reviewedByAdminId String?                     @db.Uuid
  evidenceAuditId   String?                     @db.Uuid
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  resolvedAt        DateTime?
  message           Message                     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter          User                        @relation("MessageReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedByAdmin   User?                       @relation("MessageReportReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
  @@index([reason, status])
  @@index([reviewedByAdminId, resolvedAt])
  @@map("message_reports")
}

model MessageBookmark {
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt])
  @@index([messageId])
  @@map("message_bookmarks")
}

model ConversationPreference {
  userId         String       @db.Uuid
  conversationId String       @db.Uuid
  isBookmarked   Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([userId, isBookmarked])
  @@index([userId, isArchived])
  @@index([userId, isDeleted])
  @@map("conversation_preferences")
}

model CallRecord {
  id             String       @id @db.Uuid
  conversationId String       @db.Uuid
  callerId       String       @db.Uuid
  recipientId    String       @db.Uuid
  status         CallStatus   @default(ringing)
  startedAt      DateTime     @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  endedReason    String?
  endedById      String?      @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller         User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  recipient      User         @relation("CallRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  endedBy        User?        @relation("CallEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([callerId, startedAt])
  @@index([recipientId, startedAt])
  @@index([conversationId, startedAt])
  @@index([status])
  @@map("call_records")
}

model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  fileName  String
  mimeType  String
  fileSize  Int
  data      Bytes
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}
