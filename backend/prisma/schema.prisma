generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum ConversationType {
  direct
  group
  management
}

enum ParticipantRole {
  owner
  manager
  member
}

enum ConversationStatus {
  active
  closed
  archived
}

enum MessageType {
  user
  system
}

enum SupportTicketPriority {
  low
  medium
  high
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  email                String                    @unique
  username             String                    @unique
  passwordHash         String
  role                 UserRole                  @default(user)
  about                String?
  location             String?
  profileImage         String?                   @db.Text
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  conversationsCreated Conversation[]            @relation("ConversationCreator")
  messages             Message[]
  participants         ConversationParticipant[]
  supportTickets       SupportTicket[]

  @@index([role])
  @@map("users")
}

model SupportTicket {
  id          String                @id @default(uuid()) @db.Uuid
  requesterId String                @db.Uuid
  subject     String
  message     String                @db.Text
  priority    SupportTicketPriority @default(medium)
  status      SupportTicketStatus   @default(open)
  adminNote   String?               @db.Text
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  resolvedAt  DateTime?
  requester   User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([requesterId, createdAt])
  @@index([status, priority])
  @@map("support_tickets")
}

model Conversation {
  id                     String                    @id @default(uuid()) @db.Uuid
  type                   ConversationType
  name                   String?
  description            String?
  createdBy              String                    @db.Uuid
  externalRef            String?                   @unique
  isBotManaged           Boolean                   @default(false)
  sourceName             String?
  memberCanSendMessages  Boolean                   @default(false)
  membersCanLeave        Boolean                   @default(true)
  status                 ConversationStatus        @default(active)
  parentConversationId   String?                   @unique @db.Uuid
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  creator                User                      @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  parentConversation     Conversation?             @relation("ManagementConversation", fields: [parentConversationId], references: [id], onDelete: Cascade)
  managementConversation Conversation?             @relation("ManagementConversation")
  messages               Message[]
  participants           ConversationParticipant[]

  @@index([type])
  @@index([createdBy])
  @@index([status])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String          @db.Uuid
  userId         String          @db.Uuid
  role           ParticipantRole @default(member)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  leftAt         DateTime?
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([role])
  @@index([leftAt])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  clientMessageId String?      @db.Uuid
  conversationId  String       @db.Uuid
  senderId        String?      @db.Uuid
  content         String
  messageType     MessageType  @default(user)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime?
  deletedAt       DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([messageType])
  @@index([deletedAt])
  @@map("messages")
}
