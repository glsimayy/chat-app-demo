{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "declaration":  true,
                            "removeComments":  true,
                            "emitDecoratorMetadata":  true,
                            "experimentalDecorators":  true,
                            "allowSyntheticDefaultImports":  true,
                            "target":  "ES2023",
                            "sourceMap":  true,
                            "outDir":  "./dist",
                            "skipLibCheck":  true,
                            "strict":  true,
                            "strictPropertyInitialization":  false,
                            "noImplicitAny":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "esModuleInterop":  true,
                            "rootDir":  "./src"
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}