{
  "info": {
    "_postman_id": "9d447d7a-c9ab-49ec-80c6-d51f221d7aa8",
    "name": "Chat App Demo - Backend",
    "description": "Runs the core REST flow and creates support, monitoring and onboarding groups through the external bot automation API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
          "pm.test('Request succeeded', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
          "const body = pm.response.json();",
          "pm.test('Success envelope is valid', function () { pm.expect(body.success).to.eql(true); pm.expect(body).to.have.property('data'); });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "devSecret", "value": "change-me-for-dev-reset" },
    { "key": "botSecret", "value": "change-me-for-bot-webhooks" },
    { "key": "adminToken", "value": "" },
    { "key": "memberToken", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "guestId", "value": "" },
    { "key": "directConversationId", "value": "" },
    { "key": "groupConversationId", "value": "" },
    { "key": "botGroupId", "value": "" },
    { "key": "botMessageId", "value": "" },
    { "key": "clientMessageId", "value": "" },
    { "key": "firstMessageId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Reset development data",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-dev-secret", "value": "{{devSecret}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/dev/reset",
        "description": "Development only. Clears in-memory users and conversations so the collection can be rerun."
      }
    },
    {
      "name": "02 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Backend is healthy', function () { pm.expect(pm.response.json().data.status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Register admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_admin\",\n  \"email\": \"postman.admin@example.com\",\n  \"password\": \"Demo123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('adminToken', responseData.accessToken);",
              "pm.collectionVariables.set('adminId', responseData.user.id);",
              "pm.test('First user is admin', function () { pm.expect(responseData.user.role).to.eql('admin'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Register member",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_member\",\n  \"email\": \"postman.member@example.com\",\n  \"password\": \"Demo123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('memberToken', responseData.accessToken);",
              "pm.collectionVariables.set('memberId', responseData.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Register guest",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_guest\",\n  \"email\": \"postman.guest@example.com\",\n  \"password\": \"Demo123!\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('guestId', pm.response.json().data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - List users",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Three users are available', function () { pm.expect(pm.response.json().data.length).to.be.at.least(3); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Create direct conversation",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"participantId\": \"{{memberId}}\"\n}" },
        "url": "{{baseUrl}}/conversations/direct"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('directConversationId', responseData.id);",
              "pm.test('Direct conversation returned', function () { pm.expect(responseData.type).to.eql('direct'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Send direct message",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('clientMessageId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('firstMessageId', responseData.id);",
              "pm.test('Client message id is preserved', function () { pm.expect(responseData.clientMessageId).to.eql(pm.collectionVariables.get('clientMessageId')); });"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"Postman idempotency test\",\n  \"clientMessageId\": \"{{clientMessageId}}\"\n}" },
        "url": "{{baseUrl}}/conversations/{{directConversationId}}/messages"
      }
    },
    {
      "name": "09 - Retry same direct message",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"content\": \"Postman idempotency test\",\n  \"clientMessageId\": \"{{clientMessageId}}\"\n}" },
        "url": "{{baseUrl}}/conversations/{{directConversationId}}/messages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retry returns the original message', function () { pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('firstMessageId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Create group conversation",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Demo Group\",\n  \"description\": \"Manual group policy demo\",\n  \"participantIds\": [\"{{memberId}}\"],\n  \"managerIds\": [\"{{memberId}}\"],\n  \"memberCanSendMessages\": false,\n  \"membersCanLeave\": true\n}" },
        "url": "{{baseUrl}}/conversations/groups"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('groupConversationId', responseData.id);",
              "pm.test('Group conversation returned', function () { pm.expect(responseData.type).to.eql('group'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Add guest to group",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{guestId}}\"\n}" },
        "url": "{{baseUrl}}/conversations/{{groupConversationId}}/participants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Guest was added', function () { const participants = pm.response.json().data; pm.expect(participants.some(function (participant) { return participant.userId === pm.collectionVariables.get('guestId') && !participant.leftAt; })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Remove guest from group",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/conversations/{{groupConversationId}}/participants/{{guestId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Guest was removed', function () { const participants = pm.response.json().data; pm.expect(participants.some(function (participant) { return participant.userId === pm.collectionVariables.get('guestId'); })).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Bot scenario: create support group",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-bot-secret", "value": "{{botSecret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Support TICKET-4821\",\n  \"description\": \"Customer support coordination\",\n  \"participantIds\": [\"{{memberId}}\"],\n  \"managerIds\": [\"{{adminId}}\"],\n  \"externalRef\": \"ticket-4821\",\n  \"sourceName\": \"Support system\",\n  \"memberCanSendMessages\": false,\n  \"membersCanLeave\": false,\n  \"initialBotMessage\": \"Support request received. An agent will join shortly.\"\n}"
        },
        "url": "{{baseUrl}}/bot/groups"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('botGroupId', responseData.id);",
              "pm.test('Support group is automation-managed', function () { pm.expect(responseData.externalRef).to.eql('ticket-4821'); pm.expect(responseData.isBotManaged).to.eql(true); pm.expect(responseData.memberCanSendMessages).to.eql(false); pm.expect(responseData.participants.some(function (participant) { return participant.role === 'owner'; })).to.eql(false); pm.expect(responseData.participants.length).to.be.at.least(3); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Bot scenario: add escalation user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-bot-secret", "value": "{{botSecret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participantIds\": [\"{{guestId}}\"],\n  \"managerIds\": [\"{{guestId}}\"]\n}"
        },
        "url": "{{baseUrl}}/bot/groups/{{botGroupId}}/participants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Escalation user joined', function () { const participants = pm.response.json().data; pm.expect(participants.some(function (participant) { return participant.userId === pm.collectionVariables.get('guestId') && !participant.leftAt; })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Bot scenario: send support status",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-bot-secret", "value": "{{botSecret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Ticket priority changed to high.\",\n  \"clientMessageId\": \"{{$guid}}\"\n}"
        },
        "url": "{{baseUrl}}/bot/groups/{{botGroupId}}/messages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const responseData = pm.response.json().data;",
              "pm.collectionVariables.set('botMessageId', responseData.id);",
              "pm.test('Message has a bot sender', function () { pm.expect(responseData.senderId).to.be.a('string'); pm.expect(responseData.messageType).to.eql('user'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - Verify support group history",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/conversations/{{botGroupId}}/messages?limit=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Support history contains the bot update', function () { const messages = pm.response.json().data.items; pm.expect(messages.some(function (message) { return message.id === pm.collectionVariables.get('botMessageId'); })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "17 - Bot scenario: create critical alert group",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-bot-secret", "value": "{{botSecret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Critical Alert MON-9001\",\n  \"description\": \"Critical infrastructure alert\",\n  \"participantIds\": [\"{{memberId}}\", \"{{guestId}}\"],\n  \"managerIds\": [\"{{adminId}}\"],\n  \"externalRef\": \"monitor-alert-9001\",\n  \"sourceName\": \"Monitoring system\",\n  \"memberCanSendMessages\": false,\n  \"membersCanLeave\": false,\n  \"initialBotMessage\": \"CPU usage exceeded 95%. Incident response has started.\"\n}"
        },
        "url": "{{baseUrl}}/bot/groups"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Critical alert group was created', function () { const group = pm.response.json().data; pm.expect(group.name).to.eql('Critical Alert MON-9001'); pm.expect(group.externalRef).to.eql('monitor-alert-9001'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "18 - Bot scenario: create onboarding group",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-bot-secret", "value": "{{botSecret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Onboarding HR-77\",\n  \"description\": \"New employee onboarding\",\n  \"participantIds\": [\"{{guestId}}\"],\n  \"managerIds\": [\"{{adminId}}\"],\n  \"externalRef\": \"onboarding-hr-77\",\n  \"sourceName\": \"HR system\",\n  \"memberCanSendMessages\": true,\n  \"membersCanLeave\": false,\n  \"initialBotMessage\": \"Welcome. Your onboarding checklist is ready.\"\n}"
        },
        "url": "{{baseUrl}}/bot/groups"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Onboarding group was created', function () { const group = pm.response.json().data; pm.expect(group.name).to.eql('Onboarding HR-77'); pm.expect(group.externalRef).to.eql('onboarding-hr-77'); });"
            ]
          }
        }
      ]
    }
  ]
}
